# Local synthetic development only. Never commit the populated .env file.
# Production runtime receives only runtime values, never migration/admin credentials.
# This file is never loaded implicitly; use node --env-file=.env for local commands.
PAPERQUAY_HOST=127.0.0.1
PAPERQUAY_PORT=4311
PAPERQUAY_DATABASE_URL=postgresql://paperquay_runtime:REPLACE_RUNTIME_PASSWORD@127.0.0.1:55439/paperquay_sync_test
PAPERQUAY_MIGRATION_DATABASE_URL=postgresql://paperquay_migrate:REPLACE_MIGRATION_PASSWORD@127.0.0.1:55439/paperquay_sync_test
PAPERQUAY_OIDC_ISSUER=http://127.0.0.1:18081/realms/paperquay-local
PAPERQUAY_OIDC_AUDIENCE=paperquay-sync
PAPERQUAY_OIDC_CLIENT_IDS=paperquay-mobile,paperquay-integration
PAPERQUAY_ALLOWED_ORIGINS=http://127.0.0.1:4317,http://127.0.0.1:4318
# Generate locally: node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64'))"
PAPERQUAY_CURSOR_SECRET=REPLACE_WITH_RANDOM_BASE64
# Retained JSON UTF-8 bytes + 512 bytes per row; default 256 MiB, maximum 10 GiB.
PAPERQUAY_MAX_ACCOUNT_RETAINED_BYTES=268435456

# Only the optional reference Compose/bootstrap and integration fixtures use these.
# Use independent generated secrets; keep URL passwords URL-encoded above.
PAPERQUAY_TEST_POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
PAPERQUAY_MIGRATION_DB_PASSWORD=REPLACE_MIGRATION_PASSWORD
PAPERQUAY_RUNTIME_DB_PASSWORD=REPLACE_RUNTIME_PASSWORD
PAPERQUAY_TEST_PASSWORD=REPLACE_WITH_RANDOM_TEST_PASSWORD_AT_LEAST_16_CHARS
PAPERQUAY_TEST_ALLOW_DATABASE_WRITES=1
PAPERQUAY_TEST_CLIENT_ID=paperquay-integration
PAPERQUAY_TEST_USERNAME=qa-reader
PAPERQUAY_TEST_OTHER_USERNAME=qa-other
